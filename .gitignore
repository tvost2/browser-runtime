# --- dependencies & toolchains (fetched by npm run setup:*) ---
node_modules/
tools/emsdk/
reference/                       # Babylon.js clone — only needed for `npm run analyze` / `bench:baseline`

# --- build outputs ---
web/dist/                        # `npm run build:api`
web/backend/engine.mjs           # `npm run build:wasm`
web/backend/engine.wasm
web/backend/engine.build.json
web/backend/engine-*.mjs         # build variants (--out engine-<name>)
web/backend/engine-*.wasm
web/backend/engine-*.build.json
native/*.exe                     # `npm run test:equivalence` / `bench:native` compile these
native/build/
native/build-wasm/
native/tests/fixtures/*.bin      # regenerated by `node native/tests/gen_fixtures.mjs`
*.o
*.obj

# --- benchmark run outputs (regenerable; committed reference lives in docs/) ---
bench/results/*.log
bench/results/*.csv
bench/results/prof/
bench/results/*.png
bench/results/engine-demo.json

# committed on purpose (v0.1.0 reference numbers, cited by docs/ + HARDWARE.md):
#   bench/results/*.json  ·  bench/results/HARDWARE.md  ·  bench/results/engine-demo.png
!bench/results/*.json
!bench/results/HARDWARE.md
!bench/results/engine-demo.png

