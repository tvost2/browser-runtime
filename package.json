{
  "name": "browser-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A WASM-first 3D runtime experiment using C++, WebAssembly and WebGPU. The browser is the platform.",
  "keywords": [
    "webassembly",
    "wasm",
    "webgpu",
    "cpp",
    "data-oriented",
    "ecs",
    "3d",
    "runtime",
    "experiment"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tvost2/browser-runtime.git"
  },
  "homepage": "https://github.com/tvost2/browser-runtime#readme",
  "exports": {
    ".": {
      "types": "./web/dist/types/web/api/index.d.ts",
      "import": "./web/dist/engine.js"
    }
  },
  "files": [
    "web/dist"
  ],
  "scripts": {
    "setup:emsdk": "node native/setup-emsdk.mjs",
    "setup:reference": "git clone --depth 1 https://github.com/BabylonJS/Babylon.js reference",
    "doctor": "node scripts/doctor.mjs",
    "build": "npm run build:wasm && npm run build:api",
    "build:wasm": "node native/build-wasm.mjs --profile release",
    "build:wasm:debug": "node native/build-wasm.mjs --profile debug --out engine-debug",
    "build:wasm:nosimd": "node native/build-wasm.mjs --profile o3 --out engine-o3",
    "build:api": "node web/build-api.mjs",
    "watch:api": "node web/build-api.mjs --watch",
    "serve": "node web/serve.mjs 8080",
    "demo": "npm run build && node web/serve.mjs 8080",
    "test:equivalence": "node bench/run-equivalence.mjs",
    "test:visual": "node bench/run-visual.mjs",
    "test:glb": "node bench/run-glb-equiv.mjs",
    "test:glb:native": "node bench/run-glb-native-equiv.mjs",
    "test:glb:render": "node bench/run-glb-render.mjs",
    "bench:glb": "node --expose-gc bench/run-glb-bench.mjs",
    "bench:glb:vitrine": "node --expose-gc bench/run-glb-vitrine.mjs",
    "bench:glb:pipelines": "node --expose-gc bench/run-glb-pipelines.mjs",
    "bench:glb:gpu": "node bench/run-glb-pipelines-gpu.mjs",
    "glb:fixtures": "node bench/make-glb-fixtures.mjs",
    "glb:profile": "node --expose-gc bench/run-glb-profile.mjs",
    "bench:baseline": "node --expose-gc bench/run-baseline.mjs",
    "bench:wasm": "node --expose-gc bench/run-wasm.mjs",
    "bench:native": "node bench/native-ceiling.mjs",
    "bench:scale": "node --expose-gc bench/run-scale.mjs",
    "bench:memory": "node --expose-gc bench/run-memory.mjs",
    "bench:browser": "node bench/run-browser.mjs",
    "bench:compare": "node --expose-gc bench/run-wasm.mjs && node --expose-gc bench/run-compare.mjs && node bench/report.mjs",
    "profile:pipeline": "node --expose-gc bench/profile-pipeline.mjs",
    "report": "node bench/report.mjs",
    "analyze": "node tools/migration-analyzer/analyze.mjs",
    "test:spatial": "node bench/run-spatial.mjs",
    "bench:scene": "node --expose-gc bench/run-scene-incremental.mjs",
    "bench:renderer": "node --expose-gc bench/run-renderer-incremental.mjs",
    "bench:renderer:gpu": "node bench/run-renderer-gpu.mjs",
    "test:render:patch": "node bench/run-render-patch.mjs",
    "bench:mesh-upload": "node bench/run-mesh-upload.mjs",
    "bench:gpu-cull": "node bench/run-gpu-cull.mjs",
    "bench:chunk-merge": "node bench/run-chunk-merge.mjs",
    "compare": "node web/harness/vitrine-compare/serve.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.0"
  },
  "devDependencies": {
    "@babylonjs/loaders": "^7.54.3",
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.28.2",
    "playwright": "^1.48.0",
    "typescript": "^7.0.2"
  }
}
